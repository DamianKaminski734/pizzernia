<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F1F3F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#24578B"
        android:gravity="center"
        android:text="Aktywność 2 - Podsumowanie"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Podsumowanie Zamówienia"
        android:textColor="#222222"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Rozmiar pizzy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/circle_icon"
                android:contentDescription="Ikona rozmiaru" />

            <TextView
                android:id="@+id/tvRozmiar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Rozmiar: Średnia"
                android:textColor="#222222"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Rodzaj ciasta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/palette_icon"
                android:contentDescription="Ikona ciasta" />

            <TextView
                android:id="@+id/tvCiasto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Ciasto: Cienkie"
                android:textColor="#222222"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Liczba sztuk -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/menu_icon"
                android:contentDescription="Ikona liczby sztuk" />

            <TextView
                android:id="@+id/tvSztuki"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Sztuk: 1"
                android:textColor="#222222"
                android:textSize="16sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#DDDDDD" />

        <!-- Całkowita cena -->
        <TextView
            android:id="@+id/tvRazem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Razem: 35,00 PLN"
            android:textColor="#168238"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <Button
        android:id="@+id/btnPowrot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#24578B"
        android:text="POWRÓT"
        android:textColor="#FFFFFF" />

</LinearLayout>
